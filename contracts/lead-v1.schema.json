{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hozen/jingfan-ims-intelligence/contracts/lead-v1.schema.json",
  "title": "Jingfan IMS GTM Lead Contract v1",
  "description": "Canonical, additive exchange contract. Legacy radar and enrichment reports remain supported interfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "lead_id", "lead_type", "created_at", "updated_at", "pipeline_stage", "evidence", "provenance", "pipeline_history"],
  "properties": {
    "contract_version": { "const": "1.0" },
    "lead_id": { "$ref": "#/$defs/lead_id" },
    "lead_type": { "type": "string", "enum": ["industrial", "municipal", "other"] },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "pipeline_stage": { "$ref": "#/$defs/pipeline_stage" },
    "company": { "$ref": "#/$defs/company" },
    "project": { "$ref": "#/$defs/project" },
    "signal": { "$ref": "#/$defs/signal" },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "qualification": { "$ref": "#/$defs/qualification" },
    "enrichment": { "$ref": "#/$defs/enrichment" },
    "provenance": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/provenance" } },
    "pipeline_history": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/transition" } },
    "duplicate_of": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/lead_id" } },
    "conflicts": { "type": "array", "items": { "$ref": "#/$defs/conflict" } },
    "sales_feedback": { "type": "array", "items": { "$ref": "#/$defs/sales_feedback" } }
  },
  "$defs": {
    "lead_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(IND-[0-9]{8}-[0-9]{1,4}|OPP?-[0-9]{4}-?[0-9]{2}-?[0-9]{2}-[0-9]{3,4}|ML-[0-9]{8}-[0-9]{4}|[A-Z]{1,12}(?:-[A-Za-z0-9]+)+)$",
      "description": "Preserves industrial, municipal, and historical repository IDs; never regenerate on stage change."
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "date": { "type": "string", "format": "date" },
    "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"] },
    "pipeline_stage": {
      "type": "string",
      "enum": ["RADAR", "QUALIFICATION", "QUALIFIED", "REVIEW", "REJECTED", "ENRICHMENT", "ENRICHED", "ORCHESTRATION", "SALES_READY", "ENGAGEMENT"]
    },
    "company": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "company_name": { "type": "string", "minLength": 1 },
        "normalized_company_name": { "type": ["string", "null"] },
        "location": { "type": ["string", "null"] },
        "industry": { "type": ["string", "null"] }
      },
      "required": ["company_name"]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_name": { "type": "string", "minLength": 1 },
        "project_type": { "type": ["string", "null"] },
        "project_location": { "type": ["string", "null"] },
        "project_stage": { "type": ["string", "null"] },
        "estimated_timing": { "type": ["string", "null"] }
      },
      "required": ["project_name"]
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal_type", "signal_description"],
      "properties": {
        "signal_type": { "type": "string", "minLength": 1 },
        "signal_description": { "type": "string", "minLength": 1 },
        "signal_date": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "source_name", "source_url", "source_type", "retrieved_at", "evidence_summary", "confidence"],
      "properties": {
        "evidence_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
        "source_name": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "format": "uri" },
        "source_type": { "type": "string", "minLength": 1 },
        "published_at": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "$ref": "#/$defs/date" }, { "type": "null" }] },
        "retrieved_at": { "$ref": "#/$defs/timestamp" },
        "evidence_text": { "type": ["string", "null"] },
        "evidence_summary": { "type": "string", "minLength": 1 },
        "confidence": { "$ref": "#/$defs/confidence" },
        "contributed_by": { "type": ["string", "null"] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contribution_id", "generated_by", "agent", "run_id", "generated_at"],
      "properties": {
        "contribution_id": { "type": "string", "minLength": 1 },
        "generated_by": { "type": "string", "enum": ["AI", "HUMAN", "SYSTEM", "IMPORT"] },
        "agent": { "type": "string", "minLength": 1 },
        "model": { "type": ["string", "null"] },
        "run_id": { "type": "string", "minLength": 1 },
        "generated_at": { "$ref": "#/$defs/timestamp" },
        "prompt_version": { "type": ["string", "null"] },
        "evidence_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "notes": { "type": ["string", "null"] }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reasoning", "confidence", "qualified_at", "evidence_refs", "provenance_ref"],
      "properties": {
        "decision": { "type": "string", "enum": ["PASS", "REVIEW", "REJECT"] },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "icp_fit": { "type": ["string", "null"] },
            "pain": { "type": ["string", "null"] },
            "timing": { "type": ["string", "null"] },
            "ims_fit": { "type": ["string", "null"] },
            "commercial_relevance": { "type": ["string", "null"] }
          }
        },
        "reasoning": { "type": "string", "minLength": 1 },
        "evidence_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "confidence": { "$ref": "#/$defs/confidence" },
        "qualified_at": { "$ref": "#/$defs/timestamp" },
        "provenance_ref": { "type": "string", "minLength": 1 },
        "rule_version": { "type": ["string", "null"] },
        "prompt_version": { "type": ["string", "null"] }
      }
    },
    "enrichment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["PENDING", "IN_PROGRESS", "COMPLETE", "PARTIAL"] },
        "organizations": { "type": "array", "items": { "$ref": "#/$defs/organization" } },
        "contacts": { "type": "array", "items": { "$ref": "#/$defs/contact" } },
        "notes": { "type": ["string", "null"] }
      },
      "required": ["status", "organizations", "contacts"]
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization_id", "name", "relationship_type", "confidence", "evidence_refs"],
      "properties": {
        "organization_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "relationship_type": { "type": "string", "enum": ["OWNER", "FACILITY", "EPC", "DESIGN_INSTITUTE", "SYSTEM_INTEGRATOR", "ENGINEERING_CONTRACTOR", "OTHER"] },
        "relationship_description": { "type": ["string", "null"] },
        "confidence": { "$ref": "#/$defs/confidence" },
        "evidence_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contact_id", "name", "title", "organization", "role_category", "phone", "phone_status", "email", "email_status", "confidence", "evidence_refs"],
      "properties": {
        "contact_id": { "type": "string", "minLength": 1 },
        "name": { "type": ["string", "null"] },
        "title": { "type": ["string", "null"] },
        "organization": { "type": "string", "minLength": 1 },
        "role_category": { "type": "string", "minLength": 1 },
        "phone": { "type": ["string", "null"] },
        "phone_status": { "type": "string", "enum": ["KNOWN", "UNKNOWN", "NOT_FOUND", "WITHHELD"] },
        "email": { "type": ["string", "null"] },
        "email_status": { "type": "string", "enum": ["KNOWN", "UNKNOWN", "NOT_FOUND", "WITHHELD"] },
        "confidence": { "$ref": "#/$defs/confidence" },
        "evidence_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "provenance_ref": { "type": ["string", "null"] }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "at", "provenance_ref"],
      "properties": {
        "from": { "oneOf": [{ "$ref": "#/$defs/pipeline_stage" }, { "type": "null" }] },
        "to": { "$ref": "#/$defs/pipeline_stage" },
        "at": { "$ref": "#/$defs/timestamp" },
        "reason": { "type": ["string", "null"] },
        "provenance_ref": { "type": "string", "minLength": 1 }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "values", "status"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "values": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "evidence_refs"],
            "properties": {
              "value": {},
              "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            }
          }
        },
        "status": { "type": "string", "enum": ["UNRESOLVED", "RESOLVED"] },
        "resolution": { "type": ["string", "null"] }
      }
    },
    "sales_feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "recorded_at", "recorded_by"],
      "properties": {
        "outcome": { "type": "string", "enum": ["ACCEPTED", "INFORMATION_INSUFFICIENT", "CUSTOMER_MISMATCH", "PROJECT_TOO_LATE", "CONTACT_INCORRECT", "ALREADY_AWARDED", "NO_IMS_NEED", "OTHER"] },
        "recorded_at": { "$ref": "#/$defs/timestamp" },
        "recorded_by": { "type": "string", "minLength": 1 },
        "notes": { "type": ["string", "null"] }
      }
    }
  }
}
