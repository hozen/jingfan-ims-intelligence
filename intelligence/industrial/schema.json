{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "iMS Industrial Opportunity Radar Daily Report",
  "description": "Hach iMS Industrial Market Opportunity Radar v1.0 — China Industrial Market Discovery",
  "type": "object",
  "required": [
    "report_id",
    "date",
    "radar_type",
    "market_segment",
    "experiment_week",
    "version",
    "scanner_summary",
    "top_5_match",
    "signals",
    "market_background",
    "source_effectiveness",
    "experiment_observations",
    "rejected_signals"
  ],
  "properties": {
    "report_id": {
      "type": "string",
      "description": "唯一标识符，格式: ind-radar-YYYYMMDD"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "报告日期"
    },
    "radar_type": {
      "type": "string",
      "const": "industrial",
      "description": "雷达类型 — 固定为industrial，与municipal雷达区分"
    },
    "market_segment": {
      "type": "string",
      "const": "industrial",
      "description": "市场细分 — 固定为industrial"
    },
    "experiment_week": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4,
      "description": "实验周次 1-4"
    },
    "version": {
      "type": "string",
      "description": "雷达版本号"
    },
    "scanner_summary": {
      "type": "object",
      "required": [
        "total_scanned",
        "total_signals",
        "engine_a_count",
        "engine_b_count",
        "p1_count",
        "p2_count",
        "p3_count",
        "signal_count",
        "potential_count",
        "ims_opportunity_count",
        "industry_breakdown",
        "engine_breakdown",
        "timing_breakdown"
      ],
      "properties": {
        "total_scanned": { "type": "integer" },
        "total_signals": { "type": "integer" },
        "engine_a_count": { "type": "integer", "description": "Engine A — Compliance Radar 发现数" },
        "engine_b_count": { "type": "integer", "description": "Engine B — Project/CapEx Radar 发现数" },
        "p1_count": { "type": "integer" },
        "p2_count": { "type": "integer" },
        "p3_count": { "type": "integer" },
        "signal_count": { "type": "integer", "description": "Industrial Signal 级别数" },
        "potential_count": { "type": "integer", "description": "Potential Industrial Opportunity 数" },
        "ims_opportunity_count": { "type": "integer", "description": "Industrial iMS Opportunity 数" },
        "industry_breakdown": { "type": "object" },
        "engine_breakdown": { "type": "object" },
        "timing_breakdown": { "type": "object" }
      }
    },
    "top_5_match": {
      "type": "array",
      "items": { "$ref": "#/$defs/top_match" },
      "description": "最值得公司Agent匹配的信号，按Priority排序"
    },
    "signals": {
      "type": "array",
      "items": { "$ref": "#/$defs/industrial_signal" },
      "description": "所有工业市场信号/机会"
    },
    "market_background": {
      "type": "array",
      "items": { "$ref": "#/$defs/market_background_item" },
      "description": "重大市场背景信号（非具体公司机会）"
    },
    "source_effectiveness": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_type", "signals_produced", "effectiveness"],
        "properties": {
          "source_type": { "type": "string" },
          "signals_produced": { "type": "integer" },
          "effectiveness": { "type": "string", "enum": ["最有效", "次有效", "中等", "噪声大", "待探索"] }
        }
      }
    },
    "experiment_observations": {
      "type": "object",
      "description": "实验观察和方法论评估"
    },
    "rejected_signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "reason"],
        "properties": {
          "description": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "data_source": { "type": "object" },
    "disclaimer": { "type": "string" }
  },
  "$defs": {
    "top_match": {
      "type": "object",
      "required": ["rank", "id", "name", "engine", "industry", "priority", "match_priority", "match_reason", "agent_checklist"],
      "properties": {
        "rank": { "type": "integer" },
        "id": { "type": "string", "description": "信号ID: IND-YYYYMMDD-序号" },
        "name": { "type": "string" },
        "engine": { "type": "string", "enum": ["A", "B"], "description": "A=Compliance, B=Project/CapEx" },
        "industry": { "type": "string", "enum": ["semiconductor", "battery", "petrochemical", "food_beverage", "pharma", "cross_industry"] },
        "priority": { "type": "string", "enum": ["P1", "P2", "P3"] },
        "match_priority": {
          "type": "string",
          "enum": ["A", "B", "C", "D"],
          "description": "A=最高（直接匹配SFDC/Account/Installed Base），B=中，C=批量匹配，D=归档"
        },
        "match_reason": { "type": "string" },
        "agent_checklist": {
          "type": "array",
          "items": { "type": "string" },
          "description": "公司Agent建议检查项"
        }
      }
    },
    "industrial_signal": {
      "type": "object",
      "required": [
        "id",
        "market_segment",
        "company",
        "industry",
        "location",
        "opportunity",
        "signal_tier",
        "engine",
        "evidence",
        "potential_ims_use_case",
        "logic_rationale",
        "opportunity_stage",
        "priority",
        "incrementality_status",
        "source_urls"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "IND-YYYYMMDD-序号"
        },
        "market_segment": {
          "type": "string",
          "const": "industrial",
          "description": "固定为industrial — 与municipal雷达区分"
        },
        "company": { "type": "string" },
        "industry": {
          "type": "string",
          "enum": ["semiconductor", "battery", "petrochemical", "food_beverage", "pharma", "cross_industry"]
        },
        "location": { "type": "string" },
        "opportunity": { "type": "string", "description": "机会/项目描述" },
        "signal_tier": {
          "type": "string",
          "enum": ["Tier 1", "Tier 2", "Tier 3"],
          "description": "Tier 1=强领先信号, Tier 2=支撑信号, Tier 3=弱背景"
        },
        "engine": {
          "type": "string",
          "enum": ["A", "B"],
          "description": "A=Compliance Radar, B=Project/CapEx Radar"
        },
        "evidence": {
          "type": "object",
          "required": ["facts", "inferences", "unknowns"],
          "properties": {
            "facts": {
              "type": "array",
              "items": { "type": "string" },
              "description": "公开来源明确说明的事实"
            },
            "inferences": {
              "type": "array",
              "items": { "type": "string" },
              "description": "合理判断（标注为Inference）"
            },
            "unknowns": {
              "type": "array",
              "items": { "type": "string" },
              "description": "无法验证的信息（标注为Unknown）"
            }
          }
        },
        "potential_ims_use_case": { "type": "string" },
        "logic_rationale": {
          "type": "string",
          "description": "证据链逻辑: Industrial Trigger → Water/Compliance Impact → Monitoring/Instrumentation → IMS Relevance"
        },
        "opportunity_stage": {
          "type": "string",
          "enum": ["Early Trigger", "Planning/Feasibility", "Design", "EPC/Project Prep", "Tender/Procurement", "Execution", "Completed/Too Late"],
          "description": "机会阶段 — 工业雷达特有，与市政雷达的阶段区分"
        },
        "estimated_time_window": { "type": "string" },
        "priority": {
          "type": "string",
          "enum": ["P1", "P2", "P3"]
        },
        "water_system_ownership": {
          "type": "string",
          "enum": ["A", "B", "C", "D", "N/A"],
          "description": "A=客户自建自营, B=园区集中处理, C=第三方EPC运营, D=Unknown — Engine B 专用"
        },
        "incrementality_status": {
          "type": "string",
          "const": "unknown",
          "description": "增量性状态 — 默认unknown，需公司Agent验证"
        },
        "to_verify": {
          "type": "object",
          "properties": {
            "customer_identity": { "type": "string" },
            "installed_base": { "type": "string" },
            "commercial_history": { "type": "string" },
            "ims": { "type": "string" },
            "account_sales": { "type": "string" }
          },
          "description": "公司Agent需验证项 — 与市政雷达格式一致以便Agent统一处理"
        },
        "source_urls": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        },
        "continuity": {
          "type": "object",
          "properties": {
            "first_seen": { "type": "string", "format": "date" },
            "new_facts_today": { "type": "array", "items": { "type": "string" } },
            "changed": { "type": "boolean" }
          }
        }
      }
    },
    "market_background_item": {
      "type": "object",
      "required": ["id", "title", "description", "ims_relevance", "priority"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "ims_relevance": { "type": "string" },
        "priority": { "type": "string", "enum": ["P1", "P2", "P3"] },
        "source_urls": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
